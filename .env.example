# ==============================================================================
# SKY-LINE VIRTUAL LIBRARY - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ==============================================================================

# 1. Supabase Credentials (Lấy từ Supabase Project Settings -> API)
# URL dự án Supabase (Ví dụ: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Khóa bí mật Anon Key (Public)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Khóa Service Role Key (Khuyến nghị cho Serverless backend trên Vercel để không bị chặn RLS)
# Lấy tại Supabase -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. Mật khẩu Quản trị viên (Tùy chọn, mặc định là 123456 hoặc skyline2026)
ADMIN_PASSCODE=123456

# 3. Gemini API Key (Tùy chọn, dùng cho tính năng Chat thông minh nâng cao với nhân vật)
# Lấy miễn phí tại: https://aistudio.google.com
GEMINI_API_KEY=
